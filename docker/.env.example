# InsightSemantic environment
# Copy to .env and fill in secrets before `docker compose up`.

RELEASE_IMAGE=InsightSemantic:1.0.0
RELEASE_CONTAINER_NAME=InsightSemantic

# Only published host port (bridge mode)
FRONTEND_PORT=80

# LLM keys (at least one required for agent chat)
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
ANTHROPIC_API_KEY=
GLM_API_KEY=
XIAOMI_API_KEY=

# Semantic logging
SEMANTIC_LOG_LEVEL=info

# Studio MySQL (internal container port)
MYSQL_ROOT_PASSWORD=insightos123
MYSQL_DATABASE=studio_semantic
MYSQL_USER=studio
MYSQL_PASSWORD=insightos123
MYSQL_PORT=13306

# AbilityFramework (packaged at /opt/ability/v{1,2})
ABILITY_V1_ENDPOINT=http://127.0.0.1:48080
ABILITY_V2_ENDPOINT=http://127.0.0.1:48081

# MuJoCo / ROS — DOMAIN must match across mujoco + rosbridge + abilities
ROS_DISTRO=humble
ROS_DOMAIN_ID=11
ROSBRIDGE_PORT=9091
MUJOCO_GL=egl
PLUGIN_MUJOCO_GUI_MODE=off
MUJOCO_SCENE_NAME=palletizing_depalletizing_001
MUJOCO_SCENE_ID=1

# Optional: NVIDIA GPU for faster MuJoCo EGL (not required for headless)
# NVIDIA_VISIBLE_DEVICES=all
